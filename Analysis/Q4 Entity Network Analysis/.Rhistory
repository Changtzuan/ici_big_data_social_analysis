udn_articles_NER <- read_csv("udn_articles_NER.csv")
all_articles_results <- read_csv("all_articles_results.csv")
#改變來源媒體 和 LLM 的欄位名稱 以利作業
all_articles_results <- all_articles_results %>%
rename(
